# CIVICFIX SUPABASE CONFIGURATION
# Find these in your Supabase Dashboard: https://supabase.com/dashboard -> Project Settings -> API

# 1. Supabase Project URL (e.g. https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (used in browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Supabase Service Role Key (used in backend admin/cron tasks to bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# CRON Secret Key for 24-hour escalation trigger (optional)
CRON_SECRET=your-custom-cron-secret-token
